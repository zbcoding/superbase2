############
# SuperBase² — Minimal Coolify Environment Variables
#
# Only set these in Coolify's environment panel.
# All other variables have defaults in docker-compose.coolify.yml.
# DO NOT add variables with empty values — empty string ≠ unset and will
# override the defaults, breaking services.
#
# Generate all Coolify env vars at once:
#   cd docker && sh ./utils/generate-keys.sh --coolify
#
# Then paste the full output into Coolify's environment variables panel.
#
############

# ── Required secrets (generate before first deploy) ──────────────────────────

# Database password
POSTGRES_PASSWORD=

# JWT signing secret — MUST be at least 32 characters
# Generate: openssl rand -base64 32
JWT_SECRET=

# API keys — must be signed with the JWT_SECRET above
# Generate all three (JWT_SECRET + keys) via: sh ./utils/generate-keys.sh --coolify
ANON_KEY=
SERVICE_ROLE_KEY=

# Studio login password
# Generate: openssl rand -hex 16
DASHBOARD_PASSWORD=

# Used by Realtime and Supavisor
# Generate: openssl rand -base64 48
SECRET_KEY_BASE=

# Used by Supavisor
# Generate: openssl rand -hex 16
VAULT_ENC_KEY=

# Used by Realtime to encrypt tenant rows (AES-128 — must be exactly 16 chars)
# Generate: openssl rand -hex 8
DB_ENC_KEY=

# Used by pg-meta
# Generate: openssl rand -base64 24
PG_META_CRYPTO_KEY=

# Analytics tokens
# Generate: openssl rand -base64 24
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=

# ── Required URLs (set to your domain) ───────────────────────────────────────

# Your public-facing Supabase URL
SUPABASE_PUBLIC_URL=https://supabase.yourdomain.com

# ── Optional overrides (safe defaults exist — only set if needed) ────────────

# Which pre-built Studio image to run. master publishes :latest, the
# development branch publishes :development. Leave unset for latest; set it
# to development on a test deployment so it tracks that branch instead.
# STUDIO_IMAGE_TAG=development

# App-layer basic-auth (defense-in-depth, on top of Kong). Enabled by default
# in the compose. Set to false only if you must disable the in-app credential
# check. Requires DASHBOARD_PASSWORD to be set (it is, above).
# SUPERBASE2_AUTH=true
# DASHBOARD_USERNAME=supabase
# SITE_URL=http://localhost:3000
# GOTRUE_API_EXTERNAL_URL=       # defaults to SUPABASE_PUBLIC_URL
# KONG_HTTP_PORT=8000
# KONG_HTTPS_PORT=8443
# OPENAI_API_KEY=                # enable AI assistant in Studio
# SMTP_HOST=supabase-mail        # configure real SMTP for email auth
# SMTP_PORT=2500
# SMTP_USER=
# SMTP_PASS=
