############
# SuperBase² — Minimal Coolify Environment Variables
#
# Only set these in Coolify's environment panel.
# All other variables have defaults in docker-compose.coolify.yml.
# DO NOT add variables with empty values — empty string ≠ unset and will
# override the defaults, breaking services.
#
# Generate all Coolify env vars at once:
#   cd docker && sh ./utils/generate-keys.sh --coolify
#
# Then paste the full output into Coolify's environment variables panel.
#
############

# ── Required secrets (generate before first deploy) ──────────────────────────

# Database password. Use hex only (as generated): it is embedded in connection
# URLs and SQL, so characters like @ / # ' break services.
# Set it before the first deploy and don't change it afterwards: Postgres only
# applies it when the data directory is first created, so a later change locks
# every service out of the database.
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# Optional Postgres limits (applied at database start). Every project opens its
# own connection pools to the shared cluster and its Realtime holds up to two
# replication slots, so the image defaults (100 / 5 / 10) run out after a few
# projects. Defaults below are used when these are unset.
# POSTGRES_MAX_CONNECTIONS=300
# POSTGRES_MAX_REPLICATION_SLOTS=40
# POSTGRES_MAX_WAL_SENDERS=40

# JWT signing secret — MUST be at least 32 characters
# Generate: openssl rand -base64 32
JWT_SECRET=

# API keys — must be signed with the JWT_SECRET above
# Generate all three (JWT_SECRET + keys) via: sh ./utils/generate-keys.sh --coolify
ANON_KEY=
SERVICE_ROLE_KEY=

# Studio login password
# Generate: openssl rand -hex 16
DASHBOARD_PASSWORD=

# Used by Realtime and Supavisor
# Generate: openssl rand -base64 48
SECRET_KEY_BASE=

# Used by Supavisor
# Generate: openssl rand -hex 16
VAULT_ENC_KEY=

# Used by Realtime to encrypt tenant rows (AES-128 — must be exactly 16 chars)
# Generate: openssl rand -hex 8
DB_ENC_KEY=

# Used by pg-meta
# Generate: openssl rand -base64 24
PG_META_CRYPTO_KEY=

# Analytics tokens
# Generate: openssl rand -base64 24
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=

# Shared secret between Studio and the sb2-agent (project start/stop). The
# agent refuses to start without it, and Studio waits for the agent.
# Generate: openssl rand -hex 32
SB2_AGENT_TOKEN=

# ── Required URLs (set to your domain) ───────────────────────────────────────

# Your public-facing Supabase URL — the Kong domain, without the :8000 suffix.
# Studio rejects writes (403 "CSRF") from any other origin, so open Studio
# through exactly this URL.
SUPABASE_PUBLIC_URL=https://supabase.yourdomain.com

# Your application's URL. Auth emails (confirm, magic link, invite, password
# reset) and OAuth redirect here. Every project shares it — add other allowed
# redirect targets to ADDITIONAL_REDIRECT_URLS (comma-separated).
SITE_URL=https://app.yourdomain.com
# ADDITIONAL_REDIRECT_URLS=

# ── Optional overrides (safe defaults exist — only set if needed) ────────────

# Which pre-built Studio image to run. Leave unset to follow the moving tag
# (master publishes :latest). When the GitHub workflow redeploys this app
# (COOLIFY_WEBHOOK secret), it sets this to the commit SHA it just built so
# Studio always matches the deployed compose file — create the variable here
# (any value) for that to work, since Coolify's API only updates existing ones.
# STUDIO_IMAGE_TAG=latest

# App-layer basic-auth (defense-in-depth, on top of Kong). Enabled by default
# in the compose. Set to false only if you must disable the in-app credential
# check. Requires DASHBOARD_PASSWORD to be set (it is, above).
# SUPERBASE2_AUTH=true
# DASHBOARD_USERNAME=supabase
# GOTRUE_API_EXTERNAL_URL=       # defaults to SUPABASE_PUBLIC_URL
# KONG_HTTP_PORT=8000
# KONG_HTTPS_PORT=8443
# OPENAI_API_KEY=                # enable AI assistant in Studio

# Email: there is no mail server in this stack. Until you set real SMTP
# credentials, email signups and auth emails fail — or set
# ENABLE_EMAIL_AUTOCONFIRM=true to skip email confirmation.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=admin@yourdomain.com
# ENABLE_EMAIL_AUTOCONFIRM=false
