############
# SuperBase² — additional environment variables
#
# These are the ONLY variables SuperBase² adds on top of stock Supabase.
# All standard Supabase variables come from the upstream docker/.env.example
# which Coolify auto-detects when you set the base directory to docker/.
#
# You generally don't need to change these — they're hardcoded in the
# compose file. They're listed here for documentation and so platforms
# like Coolify show them in the env var GUI if this directory is used.
#
# ──────────────────────────────────────────────────────────────────────────
# 🔒 LOCKED AFTER FIRST BOOT — these vars live in docker/.env.example but
# cannot be safely changed after the stack has booted once. Changing them
# breaks the stack or loses persisted data:
#
#   POSTGRES_PASSWORD   Baked into DB roles by roles.sql at init. The env
#                       value is only read on first init; changing it later
#                       does NOT update the DB, but every service will try
#                       to connect with the new value and fail.
#   JWT_SECRET          Written into Postgres (GUC) at init AND read by every
#                       service at runtime. Also what signs ANON_KEY and
#                       SERVICE_ROLE_KEY — rotating it invalidates both.
#   VAULT_ENC_KEY       Decrypts supavisor tenant secrets stored in the DB.
#                       Lose it → pooler can't read its own config.
#   SECRET_KEY_BASE     Encrypts realtime + supavisor internal state.
#                       Change → services can't decrypt prior tenant data.
#   PG_META_CRYPTO_KEY  Encrypts saved DB connection strings in postgres-meta.
#                       Change → saved connections in Studio become unreadable.
#
# To rotate any of these after first boot, use:
#   sh ./rotate-secrets.sh
#
# Safe to change anytime: DASHBOARD_PASSWORD, SMTP_*, SITE_URL,
# API_EXTERNAL_URL, SUPABASE_PUBLIC_URL, and any *_VERSION pin.
# ──────────────────────────────────────────────────────────────────────────
############

# Enable SuperBase² multi-project mode in Studio
# Set to "true" to activate the project switcher and SB2 dashboard
SUPERBASE2_ENABLED=true

# Path to the projects manifest inside the Studio container
# The compose file mounts this automatically — don't change unless
# you've customized the volume mount
SUPERBASE2_MANIFEST=/etc/superbase2/projects.json

# Shared bearer token between Studio and the sb2-agent sidecar.
# Studio calls the agent (which has the Docker socket) to start/stop/restart
# per-project container stacks from the web UI — replacing the old SSH step.
# REQUIRED. Generate with: openssl rand -hex 32
SB2_AGENT_TOKEN=

# Per-project service image versions
# These default to the values baked into the compose template. Leave them UNSET
# for automatic upgrades: running `git pull` updates the template defaults, and
# `docker compose up -d` picks them up immediately.
#
# Set a variable only to OVERRIDE the template default — for example, to pin a
# specific service to an older version or test a pre-release tag. If you set
# these, you must update them manually when upgrading; the upgrade checker cannot
# update env vars automatically.
#
# Current template defaults (for reference only — do not uncomment unless pinning):
# GOTRUE_VERSION=v2.186.0
# POSTGREST_VERSION=v14.5
# REALTIME_VERSION=v2.76.5
# STORAGE_VERSION=v1.37.8
# POSTGRES_META_VERSION=v0.95.2
# EDGE_RUNTIME_VERSION=v1.70.3

# pg-meta proxy timeout for long-running SQL queries (milliseconds, default 15000)
# Increase this if you run large migrations or bulk operations through the Studio.
# SUPERBASE2_PROXY_TIMEOUT_MS=15000

# Per-project storage settings — set by superbase2.sh, listed here for reference.
# STORAGE_TENANT_ID is set to the project name by superbase2.sh.
# Override GLOBAL_S3_BUCKET and REGION if you're using S3-compatible storage.
# STORAGE_TENANT_ID=<project-name>
# GLOBAL_S3_BUCKET=stub
# REGION=local

# Whether edge functions verify JWT tokens (default: true)
# FUNCTIONS_VERIFY_JWT=true
